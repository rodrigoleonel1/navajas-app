PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/navajas
JWT_SECRET=super-secret-32chars
JWT_EXPIRES=7d
ADMIN_EMAIL=admin@navajas.com
ADMIN_PASSWORD=cambiar-en-produccion
ADMIN_NAME=Admin

# URL pública del frontend (links dentro de los emails)
APP_URL=http://localhost:5173

# Secreto del cron de recordatorios (RN9). En Vercel, configurar la misma
# variable y Vercel enviará Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=cambiar-en-produccion

# Email transaccional (RN0)
# console = no envía, imprime el email en logs (dev/CI)
# smtp    = Nodemailer (Gmail, Mailtrap, etc.)
EMAIL_PROVIDER=console
EMAIL_TIMEOUT_MS=5000
MAIL_FROM=

# Solo si EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=